# AttendX Configuration

# Local Server URL (Used by Web App and Android App)
# If testing on Android/LAN, replace with your laptop's Wi-Fi IP (e.g. http://192.168.1.50:3001)
VITE_LOCAL_SERVER_URL=http://localhost:3001

# [Optional] MongoDB Atlas Connection
# If set, the server will use MongoDB as the primary database engine
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
# MONGODB_DB_NAME=attendx

# [Optional] PostgreSQL Connection for Local Server
# If left commented out or unreachable, the server auto-falls back to embedded zero-config SQLite!
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attendx

# Gmail SMTP Credentials for OTP Engine
# Create an "App Password" in your Google Account → Security → 2FA → App Passwords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here

# QR Code Signing Secret (change this in production!)
QR_SIGNING_SECRET=attendx-qr-secret-key-change-me

# Local AI Configuration (Zero API Keys required)
FACE_MODEL=buffalo_l
